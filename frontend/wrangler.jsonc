{
  // Cloudflare Workers config for the vinext (Next.js) app. Generated by `vinext init`,
  // then given the Food4U bindings. Secrets (USER_SESSION_SECRET, USER_COOKIE_SECRET,
  // JWT_SECRET_KEY, SESSION_DATABASE_URL) are NOT here: use .dev.vars locally and
  // `wrangler secret put` in prod. SESSION_DATABASE_URL moves sessions to Neon
  // (docs/deploy.md "Sessions in Neon"); without it they stay in the KV namespace below.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food4u-frontend",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "JWT_ACCESS_TOKEN_EXPIRE_MINUTES": "30m",
    "API_BASE_URL": "https://food4u-qxcn.onrender.com"
  },
  // Production resources: KV namespace "food4u-sessions" and D1 database "food4u-db".
  "kv_namespaces": [{ "binding": "cloudflare_KV", "id": "22a2864b0c8048d88c0b760e048ea568" }],
  "d1_databases": [
    {
      "binding": "cloudflare_db",
      "database_name": "food4u-db",
      "database_id": "9136a800-4a6e-4775-8881-f251127f2dd4",
      "migrations_dir": "database/migrations"
    }
  ]
}
