{
  // Cloudflare Workers config for the vinext (Next.js) app. Generated by `vinext init`,
  // then given the Food4U bindings. Secrets (USER_SESSION_SECRET, USER_COOKIE_SECRET,
  // JWT_SECRET_KEY) are NOT here: use .dev.vars locally and `wrangler secret put` in prod.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food4u-frontend",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "JWT_ACCESS_TOKEN_EXPIRE_MINUTES": "30m",
    "API_BASE_URL": "https://food4u-nrpy.onrender.com"
  },
  // Local dev uses the ids below as local store names; replace with the real
  // namespace/database ids from the Cloudflare dashboard before deploying.
  "kv_namespaces": [{ "binding": "cloudflare_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "d1_databases": [
    {
      "binding": "cloudflare_db",
      "database_name": "cloudflare_db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
