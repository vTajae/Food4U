{
  "name": "frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "check": "vinext check",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc",
    "typegen": "wrangler types",
    "cf-typegen": "wrangler types",
    "d1:local-initialize": "wrangler d1 execute food4u-db --local --file=./database/basic.sql",
    "d1:remote-initialize": "wrangler d1 execute food4u-db --remote --file=./database/basic.sql",
    "test": "tsx --import ./tests/worker-env.mjs --test tests/*.test.mts",
    "e2e:login": "node scripts/e2e/login-loop.mjs http://localhost:3001",
    "e2e:screenshots": "node scripts/e2e/screenshots.mjs http://localhost:3001 ../docs/sprint/screenshots/nextjs/after"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-spring/web": "^10.1.2",
    "@tsndr/cloudflare-worker-jwt": "^2.5.3",
    "bcrypt-ts": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.53.0",
    "react-server-dom-webpack": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vinext": "1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.7",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "@vinext/cloudflare": "1.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "playwright-core": "^1.49.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
