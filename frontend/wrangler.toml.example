# Local development config for `npm run dev`.
# Copy to wrangler.toml (gitignored) and adjust:  cp wrangler.toml.example wrangler.toml
# Every value here is a DEV-ONLY placeholder. Production bindings and secrets
# are set in the Cloudflare Pages project, never in this file.
name = "food4u-frontend"
compatibility_date = "2024-09-23"
pages_build_output_dir = "./build/client"

[vars]
USER_SESSION_SECRET = "dev-only-session-secret"
USER_COOKIE_SECRET = "dev-only-cookie-secret"
# Must match the backend's JWT secret for backend calls (login, profile) to succeed.
JWT_SECRET_KEY = "dev-only-jwt-secret"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = "30m"
API_BASE_URL = "https://food4u-nrpy.onrender.com"

# Local KV for sessions; the id only names the local store under .wrangler/.
[[kv_namespaces]]
binding = "cloudflare_KV"
id = "local-dev-kv"

# Local D1 for user accounts; create the tables with `npm run d1:local-initialize`.
[[d1_databases]]
binding = "cloudflare_db"
database_name = "cloudflare_db"
database_id = "local-dev-d1"
